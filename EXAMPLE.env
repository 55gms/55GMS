# Everything here is optional. With nothing filled in, the site runs without
# chat and accounts (games, apps and the proxy still work).
API_KEY= 
POSTGRES_URL=postgresql://username:password@localhost:5432/55gms_chat
workerAUTH=your_worker_auth_token
PORT=8080
# REDIS_URL=redis://localhost:6379
# "external" when another Wisp server (production's epoxy-server) takes
# /api/live/ and /wisp/ ahead of this one; unset, the app serves Wisp itself.
# WISP_SERVER=
# Where accounts and saves live: "worker" (db.55gms.com, default) or "postgres"
# ACCOUNT_BACKEND=worker
# Set to true during the Worker -> Postgres cutover to reject signups and save uploads
# ACCOUNT_WRITES_FROZEN=false
# Signs the session cookie set at login, which /admin (premium management)
# relies on. Use a long random string; the admin API returns 503 while unset.
# ADMIN_TOKEN_SECRET=
# Paid premium through Stripe (docs/billing.md). Off until both are set, and
# it also needs ACCOUNT_BACKEND=postgres and ADMIN_TOKEN_SECRET. A self-hosted
# copy can leave these out: nothing about billing loads or shows.
# STRIPE=sk_live_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# 55GMS Ads (gms-ads). Ads stay off until the first two are set.
# ADS_SERVER_URL=https://ads.ch3n.cc
# ADS_API_KEY=
# Any long random string, identical on every instance. Signs serve IDs.
# ADS_EDGE_SECRET=
# Where unsent stats are kept. Defaults to .ads-spool; use a persistent volume.
# ADS_SPOOL_DIR=

# Per-game cloud saves need ACCOUNT_BACKEND=postgres and ADMIN_TOKEN_SECRET
# (docs/cloud-saves.md). Saves are gzipped in Postgres; set these to send ones
# larger than SAVE_INLINE_MAX_BYTES (default 524288, after gzip) to a private
# BunnyCDN storage zone instead.
# BUNNY_SAVES_ZONE=
# BUNNY_SAVES_KEY=
# BUNNY_SAVES_HOST=storage.bunnycdn.com
# SAVE_INLINE_MAX_BYTES=524288

# When accounts asked to choose a handle run out of time (ISO date). Unset
# means no deadline and no deadline notices.
# HANDLE_MIGRATION_DEADLINE=2026-11-15T06:00:00Z
