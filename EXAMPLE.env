API_KEY= 
POSTGRES_URL=postgresql://username:password@localhost:5432/55gms_chat
workerAUTH=your_worker_auth_token
hcaptchaSecret=your_hcaptcha_secret
PORT=8080
# REDIS_URL=redis://localhost:6379
# Where accounts and saves live: "worker" (db.55gms.com, default) or "postgres"
# ACCOUNT_BACKEND=worker
# Set to true during the Worker -> Postgres cutover to reject signups and save uploads
# ACCOUNT_WRITES_FROZEN=false
# Signs admin tokens for /admin (premium management). Use a long random string;
# the admin API returns 503 while this is unset.
# ADMIN_TOKEN_SECRET=
