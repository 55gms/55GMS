[project]
title = Hexellent
version = 1.1.1
write_log = 0
minimum_log_level = 1
compress_archive = 1
publisher = unnamed
developer = unnamed
custom_resources = /levels
title_as_file_name = Hexellent

[display]
width = 1280
height = 720
high_dpi = 1
samples = 4
fullscreen = 0
update_frequency = 60
swap_interval = 0
vsync = 1
display_profiles = /builtins/render/default.display_profilesc
dynamic_orientation = 0
